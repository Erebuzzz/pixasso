{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "node scripts/prepare-site.js",
  "outputDirectory": "site",
  "redirects": [
    {
      "source": "/examples/taste-canvas",
      "destination": "/examples/taste-canvas/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/examples/assets/(.*)",
      "destination": "/examples/taste-canvas/assets/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
